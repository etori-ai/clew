{
  "name": "@clew/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "test:node": "node --import tsx --test --test-concurrency=1 tests/runtime.test.ts tests/fixture-runtime.test.ts tests/request-spans.test.ts tests/workflow-moves.test.ts",
    "test:durability": "node --import tsx --test --test-concurrency=1 --test-force-exit tests/execution-runtime.test.ts tests/timer-runtime.test.ts tests/watch-runtime.test.ts tests/job-runtime.test.ts tests/job-lease-runtime.test.ts tests/move-runtime.test.ts tests/attention-runtime.test.ts tests/failed-step-runtime.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.90",
    "@ai-sdk/otel": "1.0.169",
    "@clew/calendar": "workspace:*",
    "@clew/connectors": "workspace:*",
    "@clew/contracts": "workspace:*",
    "@clew/db": "workspace:*",
    "@dbos-inc/dbos-sdk": "5.5.0",
    "@hono/node-server": "2.1.7",
    "@hono/otel": "1.3.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "ai": "7.0.169",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "jose": "6.2.17",
    "openid-client": "6.8.9",
    "pino": "10.4.0",
    "rapidoc": "12.2.0",
    "temporal-polyfill": "1.0.8",
    "tsx": "4.23.15",
    "typebox": "1.4.6"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
