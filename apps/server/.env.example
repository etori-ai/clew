# Written by `bun run auth:setup` into apps/server/.env.local (ignored). Listed here for reference only.
OIDC_ISSUER=http://keycloak.orb.local:8090/realms/clew
OIDC_CLIENT_ID=clew-web
OIDC_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3020
MASTER_KEY=
AUTH_LOCAL_HTTP=true
# Optional: an OpenAI-compatible endpoint (open-weight model) for the question box. When set, the composer uses the
# model with read-only tools from the registry; without it, or when it is down, the deterministic router answers (D8).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Connector services (D21): comma-separated "<id>=<url>" and one secret per connector (id upper-cased, '-' as '_', 16+ characters).
# The BFF binds to loopback unless HOST is set, so in the devcontainer run a connector inside the app container,
# e.g. `CLEW_CONNECTOR_SECRET=... node connectors/hello/server.mjs`, and point CLEW_CONNECTORS at http://127.0.0.1:4010.
CLEW_CONNECTORS=
CLEW_CONNECTOR_SECRET_HELLO=
# HOST=0.0.0.0 in a container stack, so connector services can call back to /api/connectors/call.
