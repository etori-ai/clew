# Copy to .env.local in this directory. Values are public and embedded at build time.
# neutral (the default): Astryx Neutral without a municipal logo; sundsvall: official palette and original black/white dragon.
# custom: own accent colours, also without a default logo.
VITE_BRAND_PROFILE=neutral

# Required only with VITE_BRAND_PROFILE=custom. These example values pass the contrast checks.
# VITE_BRAND_ACCENT="#5b1f78"
# VITE_BRAND_ACCENT_MUTED="#d7dbf2"

# Optional logo override for any profile. Put the original image in public/branding.
# Set both values empty to hide the logo. Without overrides, the selected profile supplies the default.
# VITE_HEADER_LOGO_SRC=/branding/my-municipality.svg
# VITE_HEADER_LOGO_ALT=Kommunens namn

# Optional dark-mode variant, used with the explicit source and alt above.
# Without it, the original logo keeps a white clearance area in dark mode.
# VITE_HEADER_LOGO_DARK_SRC=/branding/my-municipality-white.svg
