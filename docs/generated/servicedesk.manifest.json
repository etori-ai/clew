  "capabilities": [
    {
      "name": "servicedesk.requests",
      "kind": "read",
      "title": "Mina beställningar i IT-servicedesken",
      "description": "Det personen har beställt eller felanmält i IT-servicedesken: nummer, typ, status och när det beräknas klart. Aldrig rubrik, beskrivning eller namn.",
      "model": true,
      "scope": {},
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^request:servicedesk:SD-[0-9]{4,12}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "waiting-on-me",
                    "new",
                    "active",
                    "closed"
                  ]
                },
                "status": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "since": {
                  "type": "string",
                  "format": "date-time",
                  "maxLength": 40
                },
                "expectedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "maxLength": 10
                    },
                    {
                      "type": "string",
                      "format": "date-time",
                      "maxLength": 40
                    }
                  ]
                },
                "link": {
                  "type": "string",
                  "maxLength": 1000,
                  "pattern": "^https?://[^\\s]+$"
                }
              },
              "required": [
                "ref",
                "label",
                "state",
                "status",
                "since"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "rows"
        ],
        "additionalProperties": false
      },
      "view": {
        "kind": "list",
        "title": "label",
        "ref": "ref",
        "modelReads": "summary",
        "noun": {
          "one": "beställning eller felanmälan",
          "other": "beställningar och felanmälningar"
        },
        "empty": "Du har inga beställningar eller felanmälningar i IT-servicedesken.",
        "open": {
          "capability": "servicedesk.request",
          "title": "Beställning eller felanmälan",
          "params": {
            "ref": "ref"
          }
        },
        "fields": [
          {
            "key": "label",
            "label": "Beställning eller felanmälan"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "expectedAt",
            "label": "Beräknas klar",
            "format": "date"
          },
          {
            "key": "since",
            "label": "Registrerad",
            "format": "date"
          }
        ]
      }
    },
