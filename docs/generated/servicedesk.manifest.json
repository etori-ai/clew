    {
      "name": "servicedesk.order",
      "kind": "execute",
      "title": "Beställ från IT-servicedesken",
      "description": "Lägger en beställning ur IT-servicedeskens katalog åt dig själv eller åt en medarbetare du är chef för. Beställningen blir din och följs tills servicedesken har levererat.",
      "model": false,
      "scope": {},
      "about": {
        "entity": "person",
        "param": "person"
      },
      "person": {
        "admits": [
          "self",
          "managed"
        ]
      },
      "execution": {
        "strategy": "deduplicated",
        "retentionSeconds": 86400,
        "lookup": "servicedesk.lookup"
      },
      "input": {
        "type": "object",
        "properties": {
          "person": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Användarnamnet på den som beställningen gäller."
          },
          "item": {
            "type": "string",
            "enum": [
              "laptop",
              "phone",
              "access-card",
              "system-access"
            ],
            "description": "Vad som beställs ur katalogen."
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "description": "Ett meddelande till servicedesken."
          }
        },
        "required": [
          "person",
          "item"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "outcome": {
                  "enum": [
                    "done",
                    "failed",
                    "unknown",
                    "skipped"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "label",
                "outcome",
                "detail"
              ],
              "additionalProperties": false
            }
          },
          "undoCapability": {
            "type": "string"
          },
          "undoMinutes": {
            "type": "integer"
          },
          "undoInput": {}
        },
        "required": [
          "headline",
          "rows"
        ],
        "additionalProperties": false
      },
      "asks": [
        {
          "kind": "choice",
          "property": "item",
          "label": "Vad",
          "required": true,
          "options": [
            {
              "value": "laptop",
              "label": "Bärbar dator"
            },
            {
              "value": "phone",
              "label": "Mobiltelefon"
            },
            {
              "value": "access-card",
              "label": "Passerkort"
            },
            {
              "value": "system-access",
              "label": "Behörighet till ett system"
