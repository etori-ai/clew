{
  "protocol": 2,
  "id": "payroll",
  "kind": "passthrough",
  "source": "Lönesystemet",
  "uses": [],
  "scan": false,
  "areas": [
    {
      "id": "payroll",
      "title": "Lön",
      "icon": "document",
      "roles": [
        "manager"
      ],
      "standing": [
        "payroll.absences"
      ],
      "schedules": [
        {
          "label": "Inläsning från personalsystemet",
          "when": "Varje natt"
        }
      ]
    }
  ],
  "capabilities": [
    {
      "name": "payroll.absences",
      "kind": "read",
      "title": "Frånvaro som nått lönesystemet",
      "description": "Sjukanmälningar som lönesystemet har läst in från personalsystemet, med dag och omfattning.",
      "model": true,
      "scope": {
        "roles": [
          "manager"
        ]
      },
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "person": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "extent": {
                  "type": "integer"
                },
                "importedAt": {
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "person",
                "from",
                "to",
                "extent",
                "importedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "rows"
        ],
        "additionalProperties": false
      },
      "view": {
        "kind": "table",
        "title": "person",
        "ref": "ref",
        "modelReads": "summary",
        "noun": {
          "one": "sjukanmälan",
          "other": "sjukanmälningar"
        },
        "empty": "Ingen sjukanmälan har nått lönesystemet.",
        "fields": [
          {
            "key": "person",
            "label": "Medarbetare"
          },
          {
            "key": "from",
            "label": "Från",
            "format": "date"
          },
          {
            "key": "to",
            "label": "Till",
            "format": "date"
          },
          {
            "key": "extent",
            "label": "Omfattning, procent",
            "format": "number"
          },
          {
            "key": "importedAt",
            "label": "Inläst",
            "format": "date"
          }
        ]
      }
    },
    {
      "name": "payroll.absenceStatus",
      "kind": "read",
      "title": "Har sjukanmälan nått lönesystemet?",
      "description": "Om lönesystemet har läst in en sjukanmälan för en medarbetare och en dag: registered eller pending.",
      "model": false,
      "scope": {
        "roles": [
          "manager"
        ]
      },
      "input": {
        "type": "object",
        "properties": {
          "person": {
            "type": "string",
            "pattern": "^hr:emp:[0-9]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "person",
          "date"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "registered",
              "pending"
            ]
          },
          "person": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "person",
          "date",
          "checkedAt"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "payroll.followAbsence",
      "kind": "propose",
      "title": "Bevaka i lönesystemet",
      "description": "Vad lönesystemet gör när en medarbetare blir sjuk: ingenting självt, så Clew bevakar att sjukanmälan kommer fram.",
      "model": false,
      "scope": {
        "roles": [
          "manager"
        ]
      },
      "follows": [
        "hr:absence"
      ],
      "input": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*:[a-z][a-zA-Z0-9-]*$",
                "maxLength": 80
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "attributes": {
                "type": "object"
              }
            },
            "required": [
              "kind",
              "attributes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "fact"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "watch"
                },
                "operation": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*\\.[a-zA-Z][a-zA-Z0-9]*$",
                  "maxLength": 80
                },
                "input": {},
                "expect": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    },
                    "equals": {}
                  },
                  "required": [
                    "path",
                    "equals"
                  ],
                  "additionalProperties": false
                },
                "within": {
                  "type": "string",
                  "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "kind",
                "operation",
                "input",
                "expect",
                "within",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      }
    }
  ]
}
