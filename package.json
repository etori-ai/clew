{
  "name": "clew",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test tests/unit",
    "db:init": "bun scripts/db-init.ts",
    "db:generate": "drizzle-kit generate",
    "auth:setup": "bun scripts/auth-setup.ts",
    "calendar": "sh scripts/calendar.sh",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.6",
    "@clew/calendar": "workspace:*",
    "@clew/contracts": "workspace:*",
    "@clew/db": "workspace:*",
    "@clew/modules": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "typescript": "7.0.2"
  }
}
