{
  "name": "clew",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "build:site-header": "bun run --cwd packages/site-header build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test tests/unit apps/web/tests",
    "test:db": "bun test tests/db",
    "test:calendar": "bun test tests/calendar",
    "test:durability": "bun run --cwd apps/server test:durability",
    "purity": "bun scripts/purity-check.ts",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,cjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,cjs,css}\"",
    "test:node": "bun run --cwd apps/server test:node",
    "test:a11y": "sh scripts/a11y.sh",
    "deps": "depcruise --config .dependency-cruiser.cjs apps/server/src packages connectors scripts tests/unit",
    "protocol:schema": "bun scripts/connector-protocol-schema.ts",
    "db:init": "bun scripts/db-init.ts",
    "db:generate": "drizzle-kit generate",
    "auth:setup": "bun scripts/auth-setup.ts",
    "calendar": "sh scripts/calendar.sh",
    "dev:connectors": "bun scripts/dev-connectors.ts",
    "dev:provision": "bun scripts/provisioner/index.ts",
    "fixtures:reset": "sh scripts/fixtures-reset.sh",
    "graph": "sh scripts/graph.sh",
    "astryx": "cd packages/ui && node ../../node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "check": "bun run format:check && bun run typecheck && bun run deps && bun run purity && bun run test && bun run test:node && bun run docs:check",
    "docs:generate": "bun scripts/docs.ts",
    "docs:smoke": "bun scripts/docs-smoke.ts",
    "docs:check": "bun scripts/docs.ts --check && bun run docs:smoke",
    "docs:site": "bun install --cwd site --frozen-lockfile && bun run --cwd site build"
  },
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "0.25.12"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.12",
    "@axe-core/playwright": "4.14.0",
    "@clew/calendar": "workspace:*",
    "@clew/connectors": "workspace:*",
    "@clew/contracts": "workspace:*",
    "@clew/db": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tanstack/query-core": "5.105.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "17.4.3",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "fast-check": "4.10.2",
    "jose": "6.2.15",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
