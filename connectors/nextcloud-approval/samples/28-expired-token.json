{
  "description": "Hillevi's exchanged token two seconds after its exp (60 s life).",
  "as": "hillevi",
  "request": {
    "method": "GET",
    "path": "/ocs/v2.php/apps/approval/api/v1/pendings",
    "headers": {
      "Authorization": "Bearer <expired exchanged access token, aud nextcloud, hillevi>",
      "OCS-APIRequest": "true",
      "Accept": "application/json"
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "ocs": {
        "meta": {
          "status": "failure",
          "statuscode": 997,
          "message": "Current user is not logged in"
        },
        "data": []
      }
    }
  }
}
