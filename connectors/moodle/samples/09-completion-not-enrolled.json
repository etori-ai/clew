{
  "description": "Completion of a course the person is not enrolled in (the site course, 1).",
  "request": {
    "method": "POST",
    "path": "/webservice/rest/server.php",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded",
      "Accept": "application/json"
    },
    "body": "wstoken=%3Cthe+service+account+token%3E&moodlewsrestformat=json&moodlewssettingraw=true&wsfunction=core_completion_get_course_completion_status&courseid=1&userid=3"
  },
  "response": {
    "status": 200,
    "headers": {
